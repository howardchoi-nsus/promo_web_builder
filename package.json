{
  "name": "promo-web-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "build": "pnpm run build:token-policy && pnpm run build:documents && pnpm run build:admin && pnpm run build:visual-editor && pnpm run build:nuxt-runtime",
    "build:documents": "node scripts/build-document-library.mjs",
    "build:admin": "vite build --config admin-app/vite.config.js",
    "build:visual-editor": "vite build --config visual-editor/vite.config.js",
    "build:nuxt-runtime": "nuxt build apps/promo-runtime-nuxt",
    "dev:nuxt-runtime": "nuxt dev apps/promo-runtime-nuxt",
    "dev:admin": "vite --config admin-app/vite.config.js",
    "dev:visual-editor": "vite --config visual-editor/vite.config.js",
    "check": "node --check prototype/app.js && node --check prototype/generated.js && node --check prototype/promo-wizard.js && node --check prototype/create-promo.js",
    "test:design-prompt-md": "node scripts/test-design-prompt-md.js",
    "qa:label-guard": "node scripts/qa-label-guard.js",
    "test:worker-contract": "node scripts/test-worker-prompt-contract.js",
    "test:integrated-brief-contract": "node scripts/test-integrated-brief-completion-contract.js",
    "test:final-worker-contract": "node scripts/test-final-worker-contract.js",
    "test:final-v2-worker-contract": "node scripts/test-final-v2-worker-contract.js",
    "test:lofi-worker-contract": "node scripts/test-lofi-worker-contract.js",
    "test:wizard-content-sections-contract": "node scripts/test-wizard-content-sections-contract.js",
    "test:wizard-form-templates-contract": "node scripts/test-wizard-form-templates-contract.js",
    "test:wizard-section-audit-log-contract": "node scripts/test-wizard-section-audit-log-contract.js",
    "test:wizard-public-form-template-contract": "node scripts/test-wizard-public-form-template-contract.js",
    "test:visual-editor-contract": "node scripts/test-visual-editor-contract.js",
    "test:visual-editor-behavior": "node scripts/test-visual-editor-behavior.mjs",
    "test:promo-token-runtime": "node scripts/test-promo-token-runtime.mjs",
    "test:wizard-layout-behavior": "node scripts/test-wizard-layout-behavior.mjs",
    "test:wizard-form-template-layout-contract": "node scripts/test-wizard-form-template-layout-contract.js",
    "test:shared-shell-header-contract": "node scripts/test-shared-shell-header-contract.js",
    "test:create-promo-clone-contract": "node scripts/test-create-promo-clone-contract.js",
    "test:create-promo-layout-cache": "node scripts/test-create-promo-layout-cache.js",
    "test:browser:install": "playwright install chromium",
    "test:create-promo-browser-smoke": "node scripts/test-create-promo-browser-smoke.mjs",
    "test:section-ai-design-contract": "node scripts/test-section-ai-design-contract.js",
    "test:section-ai-provider-contract": "node scripts/test-section-ai-provider-contract.js",
    "test:prompt-template-groups": "node scripts/test-prompt-template-groups.mjs",
    "test:no-hardcoded-runtime-prompts": "node scripts/test-no-hardcoded-runtime-prompts.js",
    "test:admin-prompt-grouping-browser": "node scripts/test-admin-prompt-grouping-browser.mjs",
    "test:component-generation-e2e": "node scripts/test-component-generation-e2e-browser.mjs",
    "start:promo-page-quality-gate": "node scripts/promo-page-browser-quality-gate-service.mjs",
    "sync:promo-page-generation-workflows": "node scripts/sync-promo-page-generation-workflows.mjs",
    "prompt-quality:plan": "node scripts/apply-web-output-prompt-quality-pack.mjs",
    "prompt-quality:check": "node scripts/apply-web-output-prompt-quality-pack.mjs --check --target=preview",
    "inspect:component-cutover": "node scripts/inspect-item-component-cutover.js",
    "design-md:dry-run": "node scripts/import-design-md-docs.js",
    "design-md:import": "node scripts/import-design-md-docs.js --apply",
    "build:token-policy": "node scripts/build-token-usage-policy.mjs",
    "test:page-schema": "node scripts/test-page-schema.mjs && node scripts/test-page-schema-api.mjs",
    "test:page-schema-browser": "node scripts/test-page-schema-browser.mjs && node scripts/test-page-schema-builder-browser.mjs",
    "test:output-isolation-ssr": "pnpm run build:nuxt-runtime && node scripts/test-output-isolation-ssr.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lottiefiles/dotlottie-vue": "^0.11.25",
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/blob": "^2.5.0",
    "@vercel/functions": "3.7.6",
    "ajv": "8.17.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "nuxt": "4.5.2",
    "playwright": "^1.61.1",
    "vite": "^8.1.4"
  }
}
