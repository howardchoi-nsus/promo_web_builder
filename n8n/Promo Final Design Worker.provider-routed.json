      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst normalized = $('Normalize Final Design Payload').item.json;\nreturn [{ json: { ...normalized, geminiImageBase64: buffer.toString('base64'), geminiImageMimeType: $binary.data?.mimeType || 'image/png' } }];"
