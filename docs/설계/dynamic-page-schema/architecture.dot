 output [label="고객 확정·품질 통과\n동일 문서·렌더러로 웹 출력·내보내기",shape=parallelogram,fillcolor="#ede9fe"];
 customer -> context -> llm -> validate -> valid;
 policy -> context; schema -> llm;
 valid -> normalize [label="예"];
 valid -> repair [label="아니오"];
 normalize -> recheck -> renderer -> preview;
 preview -> edit [label="수정 필요"];edit -> validate [constraint=false];
 preview -> assets [label="미디어 미완료"];assets -> validate [constraint=false];
 preview -> output [label="확정 가능"];
