 repair [label="오류 표시\n기존 정상 결과 유지"];
 normalize [label="반응형 기본값 보완\n모바일 1열·자연 높이·줄바꿈"];
 recheck [label="보완 결과 재검증·리비전 저장\n토큰·정책·렌더러 버전 고정"];
 renderer [label="공유 재귀 렌더러\n11종 범용 UI → DOM"];
 preview [label="Desktop·Tablet·Mobile 미리보기\n실제 화면 품질 검사",shape=parallelogram,fillcolor="#ede9fe"];
 edit [label="고객 수정\nNode ID 기반 작업·재검증"];
