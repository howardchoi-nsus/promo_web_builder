digraph Solution {
 graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.35",ranksep="0.45",fontname="Noto Sans CJK KR",label="동적 PageSchema 솔루션 · 구현 구조",labelloc=t,fontsize=22];
 node [shape=box,style="rounded,filled",fillcolor="#eff6ff",color="#42658c",fontname="Noto Sans CJK KR",fontsize=12,margin="0.18,0.12"];
